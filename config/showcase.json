{
  "name": "同规格卷筒、配套控制柜及大车油漆检验（演示工艺卡）",
  "sample_only": true,
  "description": "用于模拟检验流程与状态展示；不是企业正式验收标准。保留已配置规则，只补未配置上下限。实际使用须按图纸、端子规格、涂装工艺卡确认。",
  "rules": [
    {
      "table": "drum_param",
      "field": "diameter",
      "min": "1240",
      "max": "1260",
      "basis": "沿用项目现有卷筒样例尺寸：1250±10 mm。"
    },
    {
      "table": "drum_param",
      "field": "length",
      "min": "2990",
      "max": "3010",
      "basis": "沿用项目现有卷筒样例尺寸：3000±10 mm。"
    },
    {
      "table": "drum_param",
      "field": "thick",
      "min": "18",
      "max": "22",
      "basis": "沿用项目现有壁厚样例：20±2 mm。"
    },
    {
      "table": "drum_param",
      "field": "light",
      "min": "300",
      "max": "320",
      "basis": "沿用项目现有光段样例：310±10 mm。"
    },
    {
      "table": "travel_drive_param",
      "field": "noise",
      "min": "0",
      "max": "85",
      "basis": "沿用用户已定的机器运行噪声数值校验场景，0～85 dB 为项目样例。"
    },
    {
      "table": "control_cabinet_param",
      "field": "insulation_resistance",
      "min": "1",
      "max": "1000",
      "basis": "下限沿用设计方案附录 B 中原检验表的1 MΩ参考要求；1000 MΩ为演示量程上限，不代表通用合格上限。"
    },
    {
      "table": "control_cabinet_param",
      "field": "control_wire_torque",
      "min": "0.8",
      "max": "1.2",
      "basis": "演示端子工艺卡约定1.0±0.2 N·m；实际值取决于端子厂家和导线规格。"
    },
    {
      "table": "control_cabinet_param",
      "field": "electrical_clearance",
      "min": "8",
      "max": "20",
      "basis": "下限沿用设计方案附录 B 中原检验表8 mm参考要求；20 mm为演示布置尺寸上限，不代表通用合格上限。"
    },
    {
      "table": "travel_paint_param",
      "field": "total_thickness_ratio",
      "min": "95",
      "max": "100",
      "basis": "演示涂装工艺约定：总厚度测点达标率不低于95%；实际测点和厚度目标需按涂装工艺确定。"
    },
    {
      "table": "travel_paint_param",
      "field": "adhesion_loss_ratio",
      "min": "0",
      "max": "5",
      "basis": "演示涂装工艺约定：附着力脱落面积占比不超过5%；不是特定标准等级的自动换算。"
    },
    {
      "table": "travel_paint_param",
      "field": "primer_thickness_ratio",
      "min": "95",
      "max": "100",
      "basis": "沿用已有底漆范围，每个测点均须在范围内。"
    }
  ],
